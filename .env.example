# Скопируй в .env и заполни. Файл .env в git не попадает.
# Всё, что меняется в работе (модель, стоп-слова, режим медиа, критерии отбора),
# живёт в таблице settings и правится из бота — сюда не переносится.

# Gemini (этап 3). Ключ берётся в Google AI Studio.
GEMINI_API_KEY=
# Модель по умолчанию; актуальный список запрашивается у API командой бота.
GEMINI_MODEL=gemini-2.5-flash

# Телеграм (этап 4). Токен у @BotFather, свой user_id у @userinfobot.
BOT_TOKEN=
ADMIN_ID=
# Канал, куда публикуем: @имя или -100...
CHANNEL_ID=

# Пути и режимы (необязательно)
# DB_PATH=data/zlinbot.db
# DEBUG_DIR=debug
# HEADLESS=1
